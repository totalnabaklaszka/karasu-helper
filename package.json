{
  "name": "karasu-helper",
  "version": "1.2.3",
  "private": true,
  "description": "Minimal auto accept, veto priorities, and skins for karasu.live",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "icons": "node scripts/icons.cjs",
    "prices": "node scripts/prices.cjs",
    "source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/source-package.ps1"
  },
  "devDependencies": {
    "linkedom": "0.18.14"
  }
}
